{
  "name": "arch-trainer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "prepare:client": "node scripts/generate-build-proof.mjs",
    "dev": "npm run prepare:client && vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run prepare:client && tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run start:server",
    "start:server": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^8.2.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.58.2",
    "typescript": "^5.6.3",
    "v86": "^0.5.441",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
